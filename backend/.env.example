SECRET_KEY=your-secret-key

DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_USER=user
POSTGRES_PASSWORD=pwd
POSTGRES_DB=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://user:pwd@localhost:5432/db

# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEYS=your-fernet-key-here

FILE_UPLOAD_MAX_SIZE=10485760
RAG_TOP_K=5

# Docker + NVIDIA (Windows/Linux): leave the TEI URLs unset and run
# docker compose --profile nvidia up -d
# Compose defaults to http://embedding-model and http://reranker-model.
# macOS: run TEI locally on ports 8002 (embeddings) and 8003 (reranker),
# then uncomment both URLs below in backend/.env.
# TEI_EMBEDDING_URL=http://host.docker.internal:8002
# TEI_RERANKER_URL=http://host.docker.internal:8003

LLAMACPP_BASE_URL=http://localhost:8080

# CORS_ALLOWED_ORIGINS=https://your-frontend.com
